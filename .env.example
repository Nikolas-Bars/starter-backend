APP_NAME=Kolyansburg
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

# Порты на хосте (читает docker compose)
APP_PORT=8090
WS_PORT=8091
DB_FORWARD_PORT=33070
REDIS_FORWARD_PORT=6390

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=starter
DB_USERNAME=user
DB_PASSWORD=user

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Через сколько минут истекает токен доступа (null — бессрочно)
SANCTUM_TOKEN_EXPIRATION=10080

# Откуда фронтенду разрешено ходить в API (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5190

# Видеозвонки. Через сколько секунд неотвеченный вызов становится пропущенным
CALL_RING_TIMEOUT=30
# STUN-серверы через запятую (по умолчанию публичный бесплатный от Google)
CALL_STUN_URLS=stun:stun.l.google.com:19302
# Свой TURN (например, coturn) для пользователей за строгим NAT — пока не используется.
# С CALL_TURN_SECRET (как --static-auth-secret у coturn) каждый получает временный логин;
# без него раздаются постоянные CALL_TURN_USERNAME/CALL_TURN_CREDENTIAL
CALL_TURN_URLS=
CALL_TURN_SECRET=
CALL_TURN_USERNAME=
CALL_TURN_CREDENTIAL=
# С каких сайтов можно подключаться к WebSocket (по умолчанию — как CORS_ALLOWED_ORIGINS)
CALL_WS_ALLOWED_ORIGINS=
# Origin, который присылает мобильное приложение (starter-mobile); добавляется к сайтам выше
CALL_WS_APP_ORIGINS=starter-mobile://app

# Push на телефоны (входящие звонки при закрытом приложении). Ключ сервисного аккаунта Firebase;
# по умолчанию storage/app/firebase-credentials.json. Нет файла — push выключены
FCM_CREDENTIALS=
# Сколько секунд имеет смысл доставлять push о вызове
PUSH_CALL_TTL=30
# Сколько секунд разговор ждёт участника, у которого оборвалась связь с сервером
CALL_RESUME_TIMEOUT=20

# Автоперевод сообщений нейросетью (config/translation.php): openai или anthropic. Нет ключа — перевод выключен.
# Ключ — секрет: только здесь, в .env (он не в git), и никогда в .env фронтенда или приложения.
# Вместо самого ключа можно указать файл с ним: OPENAI_API_KEY_FILE=/путь/к/файлу
TRANSLATION_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=http://localhost:8090
