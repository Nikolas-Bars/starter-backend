APP_NAME=Starter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

# Порты на хосте (читает docker compose)
APP_PORT=8090
DB_FORWARD_PORT=33070
REDIS_FORWARD_PORT=6390

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=starter
DB_USERNAME=user
DB_PASSWORD=user

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Через сколько минут истекает токен доступа (null — бессрочно)
SANCTUM_TOKEN_EXPIRATION=10080

# Откуда фронтенду разрешено ходить в API (через запятую)
CORS_ALLOWED_ORIGINS=http://localhost:5190

L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=http://localhost:8090
