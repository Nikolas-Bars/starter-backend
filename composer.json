{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "starter/api",
    "type": "project",
    "description": "Laravel API starter: модульная архитектура, регистрация и авторизация по Bearer-токену.",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "darkaonline/l5-swagger": "^9.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10.1",
        "roadrunner-php/laravel-bridge": "^6.0",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-route-attributes": "^1.20",
        "spiral/roadrunner-http": "^3.5"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.64",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": "php vendor/bin/php-cs-fixer fix",
        "lint-check": "php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "rector": "php vendor/bin/rector --dry-run",
        "phpstan": "php vendor/bin/phpstan analyse --memory-limit=1G",
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/phpunit"
        ],
        "check": [
            "@lint-check",
            "@rector",
            "@phpstan",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.20"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
