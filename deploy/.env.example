# Скопировать в deploy/.env и заполнить. Файл читают и docker compose, и Laravel в контейнере php.
# Секреты сгенерировать: openssl rand -hex 24 (APP_KEY: echo "base64:$(openssl rand -base64 32)")

# --- Сервер ---
DOMAIN=call-yansburg.com
PUBLIC_IP=185.17.1.109
# Почта для писем Let's Encrypt о сертификате
ACME_EMAIL=

# --- Laravel ---
APP_NAME=Starter
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://call-yansburg.com

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Запросы приходят через Caddy из Docker-сети, контейнер php наружу не открыт
TRUSTED_PROXIES=*

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=starter
DB_USERNAME=starter
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

SANCTUM_TOKEN_EXPIRATION=10080

CORS_ALLOWED_ORIGINS=https://call-yansburg.com

# --- Видеозвонки ---
CALL_RING_TIMEOUT=30
CALL_STUN_URLS=stun:call-yansburg.com:3478,stun:stun.l.google.com:19302
CALL_TURN_URLS=turn:turn.call-yansburg.com:3478?transport=udp,turn:turn.call-yansburg.com:3478?transport=tcp
# Общий секрет с coturn: по нему API выдаёт каждому пользователю временный логин TURN
CALL_TURN_SECRET=
# Сколько секунд действует выданный логин TURN
CALL_TURN_TTL=21600
CALL_WS_ALLOWED_ORIGINS=https://call-yansburg.com
# Сколько секунд разговор ждёт участника, у которого оборвалась связь с сервером
CALL_RESUME_TIMEOUT=20

# --- Бэкапы (deploy/backup.sh, deploy/README.md) ---
# Открытый ключ age: им дампы шифруются, расшифровать их можно только секретным ключом, которого на сервере нет
BACKUP_AGE_RECIPIENT=
# Бот из @BotFather и id чата администратора: туда приходят копии бэкапа и предупреждения
# (место для файлов чатов кончается). Пусто — в Telegram ничего не отправляется
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# --- Файлы чатов в Cloudflare R2 (deploy/r2.sh, deploy/README.md, «Файлы чатов») ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=call-yansburg-files
# Пароль и соль шифрования копии (rclone crypt): openssl rand -base64 32. Потерять — потерять копию
ATTACHMENTS_CRYPT_PASSWORD=
ATTACHMENTS_CRYPT_SALT=

L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=https://call-yansburg.com
