{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	@api {
		path /api/* /docs /docs/* /up
		not path /api/files/*
	}
	handle @api {
		reverse_proxy php:80
	}

	# Файлы чатов: подпись ссылки проверяет PHP, а отдаёт сам Caddy — с докачкой по Range
	# и не занимая воркеры RoadRunner. Тип и имя файла приходят от PHP: обычные файлы — только на скачивание
	handle /api/files/* {
		route {
			forward_auth php:80 {
				uri /api/attachments/authorize
				copy_headers X-File-Type X-File-Disposition
			}
			uri strip_prefix /api/files
			header {
				>Content-Type {http.request.header.X-File-Type}
				>Content-Disposition {http.request.header.X-File-Disposition}
				Content-Security-Policy "default-src 'none'; sandbox"
				Cache-Control "private, max-age=172800, immutable"
			}
			root * /attachments
			file_server
		}
	}

	handle /ws {
		reverse_proxy php:8091
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self)"
		-Server
	}
}

# Artverse (соцсеть художников) временно живёт на этом сервере своим docker compose в /opt/artverse.
# Сертификат получает этот Caddy, запросы уходят в Caddy Artverse по сети edge. Artverse не запущен —
# по этому адресу 502, мессенджер это не задевает
art.{$DOMAIN} {
	reverse_proxy artverse-web:80
}

# C# School (обучение C#) временно живёт на этом сервере своим docker compose в /opt/csharp-school
# (его deploy/README.md). Сертификат получает этот Caddy, запросы уходят в Caddy C# School по сети
# edge. C# School не запущен — по этому адресу 502, мессенджер это не задевает
csharp.{$DOMAIN} {
	# Без HTTP/3: по UDP до этого сервера большие файлы (компилятор C# ~6.6 МБ) идут в разы медленнее,
	# чем по HTTP/2 (замер 2026-10-20: больше 3 минут против ~20 с). Мессенджер это не затрагивает.
	# «clear», а не просто убрать заголовок: браузеры, уже запомнившие HTTP/3, забывают его сразу
	header Alt-Svc clear
	reverse_proxy csharp-school-web:80
}
